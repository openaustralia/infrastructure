#!/usr/bin/env bash
# Displays the real inventory/aws_ec2.yml ansible plugin in ascii table
# The first call pays a one-off ansible-vault-client/1Password round-trip
# (group_vars are always loaded, even for --list);
# it's fast in a normal terminal session once that's warm.
#
# LOGNAME is the old static inventory/aws_ec2.yml's hostname.
# INSTANCE NAME is the raw EC2 Name tag.


set -euo pipefail
trap 'echo "ERROR: show-aws-inventory failed at line $LINENO (exit $?)" >&2' ERR

cd "$(dirname "$0")/.." || exit 1

if ! aws sts get-caller-identity --profile oaf >/dev/null; then
  echo "FAILED: not logged into AWS - run: aws login --profile oaf" >&2
  exit 1
fi

body="$(.venv/bin/ansible-inventory -i ./inventory/aws_ec2.yml --list 2>/dev/null |
  jq -r '
    ._meta.hostvars | to_entries[] |
    [(.value.tags.LogName // "-"), (.value.tags.Name // "-"), (if .value.tags.PublicHostname then "https://" + .value.tags.PublicHostname else "-" end), (.value.ansible_host // "-"), (.value.state.name // "-"), (.value.private_ip_address // "-"), (.value.public_ip_address // "-"), (.value.tags.AnsibleGroups // "-")] | @tsv
  ' | sort)"
if [ -n "$body" ]; then
  printf 'LOGNAME\tINSTANCE NAME\tURL\tINSTANCE\tSTATE\tPRIVATE_IP\tPUBLIC_IP\tANSIBLE_GROUPS\n%s\n' "$body" | column -t -s $'\t'
else
  echo "FAILED: no servers found - logged into AWS fine, so check filters/region/AnsibleGroups tagging instead"
fi
