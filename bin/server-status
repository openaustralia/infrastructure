#!/usr/bin/env bash
set -euo pipefail
trap 'echo "ERROR: server-status failed at line $LINENO (exit $?)" >&2' ERR

cd "$(dirname "$0")/.." || exit 1

# Quick fleet-wide health check: hostname/date (self-documenting - Ansible's own per-host prefix
# reflects the Ansible hostname/LogName, not necessarily the OS's own), uptime, memory, disk space
# and inodes (block usage and inode usage are tracked completely separately - a filesystem can
# show plenty of free space in df -m but still fail with "No space left on device" if it's out of
# inodes, e.g. from lots of small files), and any failed systemd units. Excludes
# squashfs/tmpfs/devtmpfs from both df checks - snap mounts and ephemeral filesystems otherwise
# clutter them with noise nobody's checking on. Consistent units throughout (megabytes, not a mix
# of -h and -m). One combined remote command per host (needs -m shell, not command, for the `;`
# separators) rather than several separate ansible invocations - avoids several times the per-host
# SSM connection overhead for what's meant to be a quick, pithy check.
#
#
# Any extra arguments are passed straight through to ansible - e.g. --limit planningalerts,
# --forks 1.
sep="================================================================================"
.venv/bin/ansible all -i ./inventory -m shell -a \
  "hostname; date; echo; uptime; echo; free -m; echo; df -m -x squashfs -x tmpfs -x devtmpfs; echo; df -i -x squashfs -x tmpfs -x devtmpfs; echo; echo 'Failed units:'; systemctl --failed --no-legend ; echo $sep" "$@"
